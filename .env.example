# Copy this file to `.env` and fill in your free Gemini key.
# Get one (no credit card) at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Models (optional overrides) ---------------------------------------------
# The moderator brain makes the most calls, so it defaults to flash-lite, which
# has much more free-tier headroom. (The free quota for gemini-2.5-flash is very
# small — ~20 requests/day — so it is reserved for the low-volume judge below.)
PROBEAI_MODERATOR_MODEL=gemini-2.5-flash-lite

# The eval judge runs in an ISOLATED context on a DIFFERENT model from the
# moderator, on purpose — see README "Evaluation limitations". It is low volume.
PROBEAI_JUDGE_MODEL=gemini-2.5-flash

# NOTE: Do NOT set ANTHROPIC_API_KEY while developing with Claude Code — if it is
# set, Claude Code bills the paid API instead of your Claude subscription. ProbeAI
# itself never calls Anthropic at runtime; it only talks to Gemini.
